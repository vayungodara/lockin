#!/usr/bin/env bash
# Amp orb setup for lockin (Next.js 16 + Vitest + Playwright). Idempotent; warm runs are fast.
# See https://ampcode.com/docs/orbs/customizing
set -euo pipefail
cd "$(dirname "$0")/.."

t() { printf '[%s] %s\n' "$(date +%T)" "$*"; }

t "node: $(node --version), npm: $(npm --version)"

# npm ci is already lockfile-driven; skip it when the lockfile has not changed since the last run.
stamp=node_modules/.package-lock.sha
want=$(sha256sum package-lock.json | cut -c1-16)
if [ "$(cat "$stamp" 2>/dev/null || true)" != "$want" ]; then
  t "npm ci"
  npm ci --no-audit --no-fund
  echo "$want" > "$stamp"
else
  t "node_modules match lockfile, skipping npm ci"
fi

[ -f .env.local ] || { cp -- .env.local.example .env.local && t "copied .env.local.example to .env.local"; }

# Setup prepares dependencies only. Run checks separately with npm test / npm run test:e2e.
t "done"
