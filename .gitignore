# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.sisyphus/

# playwright mcp logs
.playwright-mcp/

# playwright-cli artifacts (screenshots/snapshots/console logs from agent browser automation)
.playwright-cli/

# saved browser auth state (live cookies — never commit)
.auth/

# playwright test output
/test-results/
/playwright-report/
/playwright/.cache/

# claude code worktrees (transient agent workspaces)
.claude/worktrees/

# droid local settings (machine-specific overrides — committed settings.json travels with repo)
.factory/settings.local.json

# visual audit screenshots at repo root (logos/icons in /public are unaffected)
/*.png

# firecrawl CLI local auth cache + scraped output (project-scoped, never commit the API key)
.firecrawl
/design-references/

# other AI tools' machine-local config + personal artifacts (not app code)
.factory/
.omp/
.claude/settings.local.json.backup
/*.pdf
